#!/usr/sbin/nft -f
{{ ansible_managed | comment }}
# Second layer behind the Linode Cloud Firewall, see README.md

flush ruleset

table inet filter {
	chain input {
		type filter hook input priority filter; policy drop;

		iif lo accept
		ct state established,related accept
		ct state invalid drop

		# ICMPv6 is required for IPv6 neighbor discovery and router advertisements
		meta l4proto { icmp, ipv6-icmp } accept

		# DHCPv4 replies
		udp sport 67 udp dport 68 accept

		# SSH
		tcp dport 22 accept

		# WireGuard tunnel from the cluster
		udp dport {{ wireguard_port }} accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop

		# Only the ports forwarded to the cluster, see the nat table
		iifname "{{ ansible_facts['default_ipv4']['interface'] }}" oifname "wg0" ct status dnat accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}
{% if forwarded_udp_ports %}

table ip nat {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;

		# Forward to the cluster end of the tunnel
		iifname "{{ ansible_facts['default_ipv4']['interface'] }}" udp dport { {{ forwarded_udp_ports | join(", ") }} } dnat to {{ wireguard_cluster_address }}
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;

		# The cluster end only accepts packets from the VPS end of the tunnel,
		# and sends its replies back through the tunnel
		oifname "wg0" ct status dnat masquerade
	}
}
{% endif %}
