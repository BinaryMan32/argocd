{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMultipleMajorReleases"
  ],
  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,
  "prHourlyLimit": 0,
  "timezone": "America/Chicago",
  "schedule": ["* 8-23 * * *"],
  "automergeSchedule": ["* 8-23 * * *"],
  "packageRules": [
    {
      "description": "automatically merge all patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "create one PR per postgres/CNPG cluster",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "commitMessageTopic": "postgresql",
      "semanticCommitScope": "{{depName}}"
    },
    {
      "description": "auto merge postgres minor updates",
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "longhorn recommends migrating to each minor version separately",
      "matchPackageNames": [
        "https://github.com/longhorn/longhorn"
      ],
      "separateMultipleMinor": true
    },
    {
      "description": "linuxserver docker tags similar to 5.2.4_v2.0.15-ls480 (formerly 5.1.4-r3-ls453)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["linuxserver/qbittorrent"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-r\\d+|_v\\d+\\.\\d+\\.\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "linuxserver docker tags similar to 1.35.1.5034-ls117",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "linuxserver/prowlarr",
        "linuxserver/radarr",
        "linuxserver/sonarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "linuxserver docker tags similar to v1.5.3-ls328",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "linuxserver/bazarr"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "tdarr nodes must run the same version as the server",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/haveagitgat/tdarr",
        "ghcr.io/haveagitgat/tdarr_node"
      ],
      "groupName": "tdarr",
      "changelogUrl": "https://tdarr.io/download/"
    },
    {
      "description": "the libation UI (installed by init script) and cli cronjob open the same database",
      "matchPackageNames": [
        "rmcrackan/Libation",
        "rmcrackan/libation"
      ],
      "groupName": "libation"
    },
    {
      "description": "avoid restarting foundry during evening game sessions (6pm-2am)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["felddy/foundryvtt"],
      "schedule": ["* 8-17 * * *"],
      "automergeSchedule": ["* 8-17 * * *"]
    },
    {
      "description": "prometheus rules copied from upstream must be updated by hand before merging",
      "matchFileNames": ["infrastructure/cloudnative-pg-alerts/**"],
      "automerge": false,
      "prBodyNotes": [
        "Diff the upstream rules between these versions and update `{{packageFile}}` before merging. See `infrastructure/cloudnative-pg-alerts/README.md`."
      ]
    },
    {
      "description": "show upstream changes to cloudnative-pg cluster chart prometheus rules",
      "matchFileNames": ["infrastructure/cloudnative-pg-alerts/**"],
      "matchPackageNames": ["cloudnative-pg/charts"],
      "prBodyNotes": [
        "Upstream rule history: https://github.com/{{depName}}/commits/{{newValue}}/charts/cluster/prometheus_rules",
        "Upstream rule changes between these versions (no output means no changes):\n\n```sh\ngh api repos/{{depName}}/compare/{{currentValue}}...{{newValue}} \\\n  --jq '.files[] | select(.filename | startswith(\"charts/cluster/prometheus_rules/\")) | \"--- \\(.filename) (\\(.status))\\n\\(.patch)\"'\n```"
      ]
    },
    {
      "description": "show upstream changes to cloudnative-pg default prometheus rules",
      "matchFileNames": ["infrastructure/cloudnative-pg-alerts/**"],
      "matchPackageNames": ["cloudnative-pg/cloudnative-pg"],
      "prBodyNotes": [
        "Upstream rule history: https://github.com/{{depName}}/commits/{{newValue}}/docs/src/samples/monitoring/prometheusrule.yaml",
        "Upstream rule changes between these versions (no output means no changes):\n\n```sh\ngh api repos/{{depName}}/compare/{{currentValue}}...{{newValue}} \\\n  --jq '.files[] | select(.filename == \"docs/src/samples/monitoring/prometheusrule.yaml\") | \"--- \\(.filename) (\\(.status))\\n\\(.patch)\"'\n```"
      ]
    }
 ],
  "argocd": {
    "managerFilePatterns": [
      "/templates/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "kustomize referencing files in repository",
      "managerFilePatterns": [
        "/kustomization.yaml/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]*/[^/]*)/(?<currentValue>.*?)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "kustomize referencing files in release artifacts",
      "managerFilePatterns": [
        "/kustomization.yaml/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]*/[^/]*)/.*?(?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update docker image version",
      "managerFilePatterns": [
        "/templates/.+\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*image=(?<depName>\\S+)\\s+tag:\\s*(?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update postgresql in CNPG clusters, using the cluster name as depName to get one PR per cluster",
      "managerFilePatterns": [
        "/\\.yaml$/"
      ],
      "matchStrings": [
        "kind:\\s*Cluster\\s*\\nmetadata:\\s*\\n\\s+name:\\s*(?<depName>\\S+)[\\s\\S]*?\\n\\s+imageName:\\s*(?<packageName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^\\s@]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update app versions installed by container init scripts",
      "managerFilePatterns": [
        "/services/media/libation/config/.+\\.sh$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update kubernetes version",
      "managerFilePatterns": [
        "/system-upgrade/.+-plan.yaml/"
      ],
      "matchStrings": [
        "#\\s*renovate\\s+version:\\s*(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "k3s-io/k3s"
    },
    {
      "customType": "regex",
      "description": "Track upstream sources of copied files",
      "managerFilePatterns": [
        "/cloudnative-pg-alerts/.+\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*#\\s*https://github\\.com/[^/]+/[^/]+/tree/(?<currentValue>[^/\\s]+)/"
      ]
    }
  ]
}
